{
  "name": "a-la-nantaise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "preview": "vite preview",
    "env:frontend:default": "node scripts/frontend-env-diagnostic.mjs default",
    "env:frontend:local": "node scripts/frontend-env-diagnostic.mjs local",
    "env:frontend:effective": "node scripts/frontend-env-diagnostic.mjs effective",
    "supabase:test:start": "node scripts/supabase-test-stack.mjs start",
    "supabase:test:stop": "node scripts/supabase-test-stack.mjs stop",
    "supabase:test:status": "node scripts/supabase-test-stack.mjs status",
    "test:sql:local": "node scripts/run-supabase-sql-tests.mjs",
    "test:sql:isolation": "node scripts/run-supabase-sql-isolation.mjs",
    "db:setup:realistic": "node --experimental-strip-types scripts/db-setup-realistic.mjs",
    "db:sync:fixtures:local": "node --experimental-strip-types scripts/sync-fixtures-local.mjs",
    "db:seed:predictions:local": "node --experimental-strip-types scripts/seed-dev-predictions.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/**/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
