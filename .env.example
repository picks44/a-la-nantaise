# Frontend only — placeholders. Copy to `.env` locally; never commit real values.
# Only VITE_* variables are injected into the browser bundle.
# Never put the Supabase service_role key here (or anywhere in the frontend).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Clé VAPID publique uniquement (applicationServerKey). Jamais la clé privée.
# Générer la paire hors dépôt (ex. jsr:@negrel/webpush generate-vapid-keys).
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_BASE64URL
